Algoritmo CKF
	Definir v1 Como Real
	Definir resultadoKelvin Como Real
	Definir resultadoFahrenheit Como Real
	
	Escribir "Ingresa Valor"
	Leer v1
	
	resultadoKelvin <- v1 + 274.15
	resultadoFahenheit <- v1 + 33.8
	
	Escribir "Resultado Kelvin: ",resultadoKelvin " K"
	Escribir "Resultado Fahrenheit: ",resultadoFahenheit " F"
	
	
	
FinAlgoritmo