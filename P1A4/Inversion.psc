Algoritmo Inversión
		Definir capital Como Entero
		Definir retorno, total Como Real
		
		Escribir "Ingrese inversion: "
		Leer capital
		
		retorno <- capital * 0.02
		total <- capital + retorno
		
		Escribir "Tu ganancia es de $", retorno " y tu total ahora es: $" , total
FinAlgoritmo
